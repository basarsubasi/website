# application.go loads .env from the working directory automatically.
# Precedence: CLI flags > process environment > .env > defaults.
# Use -env /path/to/file or -env "" to disable file loading.
# HTTP_ADDR=127.0.0.1:8080
# FRONTEND_DIR=frontend/dist
# SQLite content and durable backup queue. Preserve this file and its volume.
# DATABASE_PATH=data/website.db
# Required; at least 16 characters. Missing settings stop startup.
ADMIN_PASSWORD=
# Set true behind HTTPS in production; false for local HTTP development.
COOKIE_SECURE=false
# Optional comma-separated CIDRs of reverse proxies allowed to supply
# X-Forwarded-For. Empty means trust only the direct connection address.
# Set only your actual proxies; never trust all addresses.
TRUSTED_PROXY_CIDRS=
# Enabled by fly.toml only. Trusts Fly-Client-IP from private-network peers.
# Requires Fly Proxy as the public entry point and trusted private workloads.
TRUST_FLY_PROXY=false

# R2 image files and asynchronous backups (all required except endpoint/account choice).
# One public bucket holds photos, the backup catalog, and full posts INCLUDING drafts.
# Generate S3 credentials for this bucket with Object Read & Write access.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public bucket custom domain, or an enabled r2.dev URL for development.
R2_PUBLIC_URL=
# Optional: override for jurisdiction-specific R2 endpoints.
R2_ENDPOINT=
