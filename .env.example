# application.go loads .env from the working directory automatically.
# Precedence: CLI flags > process environment > .env > defaults.
# Use -env /path/to/file or -env "" to disable file loading.
# HTTP_ADDR=127.0.0.1:8080
# Best-effort per-process concurrency limits; all must be positive integers.
# HTTP_MAX_REQUESTS=32
# HTTP_MAX_UPLOADS=2
# HTTP_MAX_CONNECTIONS=128
# FRONTEND_DIR=frontend/dist
# SQLite read cache; writes wait for R2 before reporting success.
# DATABASE_PATH=data/website.db
# Fresh process-local database restored from R2 on every cold start (enabled on Fly).
# EPHEMERAL_DATABASE=false
# Maximum time for startup R2 restore.
# RESTORE_TIMEOUT=5m
# Required; at least 16 characters. Missing settings stop startup.
ADMIN_PASSWORD=
# Set true behind HTTPS in production; false for local HTTP development.
COOKIE_SECURE=false
# Optional comma-separated CIDRs of reverse proxies allowed to supply
# X-Forwarded-For. Empty means trust only the direct connection address.
# Set only your actual proxies; never trust all addresses.
TRUSTED_PROXY_CIDRS=
# Enabled by fly.toml only. Trusts Fly-Client-IP from private-network peers.
# Requires Fly Proxy as the public entry point and trusted private workloads.
TRUST_FLY_PROXY=false

# R2 image files and synchronous backups (all required except endpoint/account choice).
# Two distinct buckets: gallery photos, and blog images/posts INCLUDING draft backups.
# Generate shared S3 credentials with Object Read & Write access to both buckets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PHOTOS_BUCKET=
R2_BLOG_BUCKET=
# Each bucket needs its own public custom domain (or r2.dev URL for development).
R2_PHOTOS_PUBLIC_URL=
R2_BLOG_PUBLIC_URL=
# Optional: override for jurisdiction-specific R2 endpoints.
R2_ENDPOINT=
