# Local logs.
*.log

# Editor and operating-system files.
.idea/
*.iml
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
Desktop.ini

# Browser test artifacts.
/ui/test-results/
/ui/playwright-report/
__pycache__/

# Keep the complete generated dependency tree, including upstream fixture files.
!/vendor/**
