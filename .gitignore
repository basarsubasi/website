!*.env.example

# Go builds, test output, and profiling.
/bin/
/.tmp/
/website
*.test
*.prof
/coverage/
/coverage.out
/coverage.html

# Frontend dependencies, builds, and caches.
node_modules/
/ui/dist/
.vite/
*.tsbuildinfo

