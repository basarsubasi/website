{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gomod", "npm", "dockerfile", "github-actions", "custom.regex"],
  "ignorePaths": ["**/vendor/**", "**/node_modules/**", "**/dist/**", ".tmp/**"],
  "dependencyDashboard": { "enabled": true },
  "automerge": false,
  "prConcurrentLimit": 5,
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[\\w-]+: (?<currentValue>[\\w.+-]+)"
      ]
    }
  ]
}
